<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For the embedded deno executable ONLY, when it is signed with the hardened runtime
     (RUNTIME=deno builds). V8 needs allow-jit: tested, a hardened deno without it crashes.
     ffmpeg and qjs need no entitlements (tested hardened). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
