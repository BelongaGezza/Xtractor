<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Developer ID path of scripts/sign.sh (hardened runtime), for the Xtractor executable only.
     disable-library-validation is required: the PyInstaller bootloader dlopen()s libpython and
     extension modules extracted to $TMPDIR, which do not carry this app's Team ID (verified:
     without it the binary fails to start). allow-unsigned-executable-memory was REMOVED after
     testing a hardened-runtime build without it: --version, --list-formats, -a, -v and the
     offline self-test all pass (docs/BUILD_NOTES.md section 8). -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
